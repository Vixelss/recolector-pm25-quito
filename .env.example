# Plantilla de variables de entorno.
# Copiar este archivo como ".env" y completar los valores reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Token de la API de AQICN (https://aqicn.org/data-platform/token/)
WAQI_TOKEN=

# Cadena de conexión de Neon (Dashboard > Connect), debe incluir ?sslmode=require
DATABASE_URL=
